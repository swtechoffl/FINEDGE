# Copy this file to .env and fill in at least one of the two keys below.
# The pipeline works with only GEMINI_API_KEY, only OPENROUTER_API_KEY, or
# both set (Gemini is tried first; OpenRouter is the fallback if Gemini
# throws — see CLAUDE.md for why the order is fixed).

# Free, no card required: https://aistudio.google.com
GEMINI_API_KEY=

# Free tier available: https://openrouter.ai/keys
OPENROUTER_API_KEY=
