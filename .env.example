# Copy this file to .env and fill in your own key.
# Free, no card required: https://console.groq.com/keys
GROQ_API_KEY=

# Create a bot via @BotFather on Telegram to get a token, then add the bot to
# your target channel/group and get its chat ID (e.g. via @getidsbot or the
# getUpdates API) — used for the daily 8:30am IST poster delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional but recommended once deployed: set the same value here and as a
# Vercel env var. Vercel signs its Cron requests with this as a bearer token;
# the /api/cron/telegram-posters route rejects any request without a match
# once this is set, so it can't be triggered by anyone who finds the URL.
CRON_SECRET=
